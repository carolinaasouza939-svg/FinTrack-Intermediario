<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="760.0" spacing="24.0" stylesheets="@fintrack.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.capacita.fintrack.view.TelaRelatorioController">
   <padding>
      <Insets bottom="24.0" left="40.0" right="40.0" top="24.0" />
   </padding>
   <children>
      <Label styleClass="titulo" text="Relatório" />
      <GridPane hgap="24.0" vgap="18.0">
         <children>
            <Label text="Total de receitas" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="rotuloReceitas" styleClass="valor-relatorio, positivo" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Total de despesas" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="rotuloDespesas" styleClass="valor-relatorio, negativo" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Saldo" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="rotuloSaldo" styleClass="valor-relatorio" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Transações registradas" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="rotuloQuantidade" styleClass="valor-relatorio" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button onAction="#aoClicarVoltar" styleClass="botao-principal" text="Voltar" />
         </children>
      </HBox>
   </children>
</VBox>
