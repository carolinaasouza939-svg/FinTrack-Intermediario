<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="520.0" prefWidth="760.0" stylesheets="@fintrack.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.capacita.fintrack.view.TelaPrincipalController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="cabecalho">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label styleClass="titulo" text="FinTrack" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="rotuloSaldo" styleClass="saldo" text="Saldo: R$ 0,00" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tabelaTransacoes" BorderPane.alignment="CENTER">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn fx:id="colunaData" prefWidth="120.0" text="Data" />
            <TableColumn fx:id="colunaDescricao" prefWidth="320.0" text="Descrição" />
            <TableColumn fx:id="colunaTipo" prefWidth="100.0" text="Tipo" />
            <TableColumn fx:id="colunaValor" prefWidth="170.0" styleClass="coluna-numerica" text="Valor" />
         </columns>
         <BorderPane.margin>
            <Insets bottom="0.0" left="20.0" right="20.0" top="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
         </padding>
         <children>
            <Button onAction="#aoClicarNova" styleClass="botao-principal" text="Nova transação" />
            <Button onAction="#aoClicarEditar" text="Editar" />
            <Button onAction="#aoClicarRemover" styleClass="botao-perigo" text="Remover" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#aoClicarRelatorio" text="Relatório" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
